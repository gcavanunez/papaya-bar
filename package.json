{
	"name": "papaya-bar",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"dev:ext": "pnpm --filter extension dev",
		"dev:dash": "pnpm --filter dashboard dev",
		"dev:server": "pnpm --filter server dev",
		"build": "pnpm --filter dashboard build && pnpm --filter extension build",
		"deploy": "pnpm --filter dashboard build && pnpm --filter server deploy",
		"lint": "eslint . --fix",
		"format": "prettier --write 'apps/*/src/**/*.{ts,vue,js}'"
	},
	"devDependencies": {
		"@eslint/js": "^9.19.0",
		"@vue/eslint-config-typescript": "^14.6.0",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-vue": "^10.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.23.0"
	}
}
